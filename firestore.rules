rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Tournament rooms are publicly readable so spectators can watch
    // without being given write access.
    match /artifacts/{appId}/public/data/tournaments/{roomCode} {
      allow read: if true;

      // ONLY Firebase Auth users carrying the custom "admin" claim may
      // create, update, or delete tournament data.
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}